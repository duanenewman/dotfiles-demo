# Pulled into ~/.gitconfig with [include] by install.sh.
#
# No [user] section on purpose: your name/email come from the machine
# (VS Code copies your host identity into dev containers) or from
# ~/.gitconfig.local. That also keeps work and personal identities apart.

[init]
	defaultBranch = main
[pull]
	ff = only
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rebase]
	autoStash = true
[diff]
	colorMoved = default
[alias]
	st = status -sb
	co = checkout
	sw = switch
	last = log -1 HEAD --stat
	amend = commit --amend --no-edit
	unstage = restore --staged
	lg = log --graph --pretty=format:'%C(yellow)%h%Creset %s %C(green)(%cr)%Creset %C(blue)<%an>%Creset%C(auto)%d%Creset'
	aliases = !git config --get-regexp '^alias\\.' | sed 's/^alias\\.//'

# Last, so machine-specific settings win. Missing file = silently skipped.
[include]
	path = ~/.gitconfig.local
