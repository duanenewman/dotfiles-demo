# Global defaults, linked to ~/.editorconfig. Editors look for .editorconfig
# files up the tree, so this applies to any project that doesn't override it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
